<UserControl x:Class="AutoFan.App.MeasuredRpmChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource Brush.Card}"
          CornerRadius="12"
          Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <TextBlock x:Name="TitleLabel"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="HowToLabel"
                     Margin="0,4,0,0"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.Muted}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasRpmPlotFans, Converter={StaticResource BoolVis}}">
          <ComboBox MinWidth="150"
                    ItemsSource="{Binding RpmPlotFans}"
                    DisplayMemberPath="FanGroupName"
                    SelectedItem="{Binding SelectedRpmPlotFan}" />
          <RadioButton Margin="8,0,0,0"
                       Style="{StaticResource ChipRadio}"
                       Content="CPU"
                       GroupName="RpmPlotTarget"
                       IsChecked="{Binding IsCpuRpmPlotTarget, Mode=TwoWay}" />
          <RadioButton Margin="6,0,0,0"
                       Style="{StaticResource ChipRadio}"
                       Content="GPU"
                       GroupName="RpmPlotTarget"
                       IsChecked="{Binding IsGpuRpmPlotTarget, Mode=TwoWay}" />
        </StackPanel>
      </Grid>
      <Canvas x:Name="PlotCanvas"
              Grid.Row="1"
              MinHeight="280"
              Margin="0,12,0,0" />
      <WrapPanel x:Name="LegendPanel"
                 Grid.Row="2"
                 Margin="0,12,0,0">
        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
          <Ellipse Width="10"
                   Height="10"
                   Fill="{StaticResource Brush.Accent}"
                   Stroke="{StaticResource Brush.Window}"
                   StrokeThickness="2"
                   VerticalAlignment="Center" />
          <TextBlock Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource Brush.Muted}"
                     Text="Tested speed" />
        </StackPanel>
        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
          <Ellipse Width="10"
                   Height="10"
                   Fill="{StaticResource Brush.Ok}"
                   Stroke="{StaticResource Brush.Window}"
                   StrokeThickness="2"
                   VerticalAlignment="Center" />
          <TextBlock Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource Brush.Muted}"
                     Text="1 °C plateau (almost no extra cooling)" />
        </StackPanel>
        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
          <Rectangle Width="18"
                     Height="2"
                     VerticalAlignment="Center"
                     Stroke="{StaticResource Brush.Ok}"
                     StrokeThickness="2"
                     StrokeDashArray="3 3" />
          <TextBlock Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource Brush.Muted}"
                     Text="Quietest useful speed" />
        </StackPanel>
      </WrapPanel>
      <TextBlock x:Name="CaptionLabel"
                 Grid.Row="3"
                 Margin="0,8,0,0"
                 FontSize="13"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.Muted}" />
      <TextBlock x:Name="EmptyLabel"
                 Grid.Row="1"
                 Foreground="{StaticResource Brush.Muted}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
