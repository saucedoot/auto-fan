<Window x:Class="AutoFan.App.OptimizeWalkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimize this PC"
        Height="520"
        Width="720"
        MinHeight="520"
        MinWidth="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="188" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Steps}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="0,0,0,12"
                     FontSize="14"
                     Text="{Binding Title}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="0" Grid.Column="2">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Headline}" />
      <TextBlock Margin="0,12,0,0"
                 Foreground="{StaticResource Brush.Muted}"
                 Text="{Binding Detail}" />
      <TextBlock Margin="0,16,0,0" Text="{Binding StatusText}" />
    </StackPanel>

    <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="False">
      <Button DockPanel.Dock="Right"
              MinWidth="160"
              Height="40"
              Content="{Binding PrimaryText}"
              IsEnabled="{Binding CanPrimary}"
              Click="OnPrimary" />
      <Button DockPanel.Dock="Right"
              Margin="0,0,12,0"
              MinWidth="100"
              Height="40"
              Style="{StaticResource SecondaryButton}"
              Content="Cancel"
              IsEnabled="{Binding CanCancel}"
              Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"
              Click="OnCancel" />
    </DockPanel>
  </Grid>
</Window>
